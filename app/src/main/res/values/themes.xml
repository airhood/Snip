<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Snip" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/snip_primary</item>
        <item name="colorOnPrimary">@color/snip_on_primary</item>
    </style>

    <style name="Theme.Snip.Transparent" parent="Theme.Snip">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
