<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility: we need to check install status / target these by package -->
    <queries>
        <package android:name="com.anthropic.claude" />
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.google.android.apps.bard" />
    </queries>

    <application
        android:name=".SnipApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Snip"
        android:supportsRtl="true">

        <!-- Settings / main entry point -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Snip">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Region-selection UI shown right after a screenshot is captured -->
        <activity
            android:name=".capture.RegionSelectActivity"
            android:exported="false"
            android:theme="@style/Theme.Snip.Transparent"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="false" />

        <!-- Own-UI chat screen, shown after a capture when response mode = own API.
             Distinct taskAffinity + singleTask so it never lands in MainActivity's task
             (which happens silently whenever that task already exists in the background) —
             otherwise back-navigating out of chat surfaces the settings screen instead of
             whatever app was open before the capture. -->
        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.Snip.Transparent"
            android:taskAffinity=":chat"
            android:launchMode="singleTask"
            android:excludeFromRecents="true" />

        <!-- Edge-swipe trigger + takeScreenshot() capture -->
        <service
            android:name=".trigger.SnipAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Assistant-role activation path -->
        <service
            android:name=".assistant.SnipVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <service
            android:name=".assistant.SnipVoiceInteractionSessionService"
            android:exported="false"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <service
            android:name=".assistant.SnipRecognitionServiceStub"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
